# Parametros dos testes da inversao por Cholesky, versao de 64 bits: ap_fixed<64,32>
# na copia ../cholesky_hardware_64bits/ (mesmos fontes do cholesky_hardware/). E o
# maior formato que o golden_cholesky.py reproduz bit a bit: o hls::sqrt so usa o
# algoritmo modelado com F <= 32 e I <= 34.
#
# Formato: NOME=valor, uma variavel por linha, sem aspas e sem comentario na
# mesma linha do valor. Valor vazio = padrao do cholesky.h.
#
# Os nomes CHOL_* sao os mesmos das macros do cholesky.h: cada linha com valor
# vira -DNOME=valor no C++ e a opcao correspondente no golden_cholesky.py.
# Os modos de quantizacao sao AP_TRN, AP_TRN_ZERO, AP_RND, AP_RND_ZERO,
# AP_RND_MIN_INF, AP_RND_INF e AP_RND_CONV; os de estouro sao AP_SAT,
# AP_SAT_ZERO, AP_SAT_SYM, AP_WRAP e AP_WRAP_SM.

# ---------------------------------------------------------------------------
# Versao do hardware
# ---------------------------------------------------------------------------
# completa = ../cholesky_hardware/ (todos os tipos, inclusive intermediarios)
# apfixed  = ../cholesky_hardware_apfixed/ (so dimensao, dados e acumulador;
#            na versao apfixed os intermediarios abaixo nao existem e precisam
#            ficar vazios)
VERSAO=cholesky_hardware_64bits

# ---------------------------------------------------------------------------
# Dimensao da matriz (M_c)
# ---------------------------------------------------------------------------
CHOL_N=8

# ---------------------------------------------------------------------------
# Dados (fixed_t). INT_BITS inclui o sinal.
# ---------------------------------------------------------------------------
CHOL_INT_BITS=32
CHOL_FRAC_BITS=32
CHOL_QUANT=AP_TRN
CHOL_OVERFLOW=AP_SAT

# ---------------------------------------------------------------------------
# Acumulador (acc_fixed_t). Padrao: o dobro dos bits e os modos dos dados.
# ---------------------------------------------------------------------------
CHOL_ACC_INT_BITS=
CHOL_ACC_FRAC_BITS=
CHOL_ACC_QUANT=
CHOL_ACC_OVERFLOW=

# ---------------------------------------------------------------------------
# Intermediarios (so na versao completa)
# ---------------------------------------------------------------------------

# Operandos de cada multiplicador. Tudo vazio = sem conversao (cada
# multiplicador usa o tipo dos proprios operandos); com algum campo, os que
# faltam vem do acumulador.
CHOL_MULIN_INT_BITS=
CHOL_MULIN_FRAC_BITS=
CHOL_MULIN_QUANT=
CHOL_MULIN_OVERFLOW=

# Cada produto real a*b. Padrao: exato (o dobro do acumulador).
CHOL_PROD_INT_BITS=
CHOL_PROD_FRAC_BITS=
CHOL_PROD_QUANT=
CHOL_PROD_OVERFLOW=

# a*b - c*d e a*d + b*c do produto complexo. Padrao: exato (PROD + 1 bit inteiro).
CHOL_CMUL_INT_BITS=
CHOL_CMUL_FRAC_BITS=
CHOL_CMUL_QUANT=
CHOL_CMUL_OVERFLOW=

# Numerador x*conj(y) da divisao complexa. Padrao: igual ao acumulador.
CHOL_NUM_INT_BITS=
CHOL_NUM_FRAC_BITS=
CHOL_NUM_QUANT=
CHOL_NUM_OVERFLOW=

# |y|^2, o divisor da divisao complexa. Padrao: igual ao acumulador.
CHOL_NORM_INT_BITS=
CHOL_NORM_FRAC_BITS=
CHOL_NORM_QUANT=
CHOL_NORM_OVERFLOW=

# Quociente da divisao (e precisao do divisor). Padrao: igual ao acumulador.
CHOL_QUOT_INT_BITS=
CHOL_QUOT_FRAC_BITS=
CHOL_QUOT_QUANT=
CHOL_QUOT_OVERFLOW=

# Soma acumulada da substituicao direta e da inversao. Padrao: igual ao acumulador.
CHOL_SUM_INT_BITS=
CHOL_SUM_FRAC_BITS=
CHOL_SUM_QUANT=
CHOL_SUM_OVERFLOW=

# Entrada e saida do hls::sqrt. So bits: os modos sao sempre AP_TRN e AP_WRAP.
# Padrao: igual aos dados.
CHOL_SQRT_INT_BITS=
CHOL_SQRT_FRAC_BITS=
